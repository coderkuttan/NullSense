__pycache__/
*.py[cod]
.env
venv/
datasets/
*.zip
.DS_Store
.vscode/
.idea/
*.log

# Ignore all model weights/exports by default
*.pt
*.onnx

# --- Exceptions: allow trained models in models/ to be committed ---
# (needed so the trained model can be pulled and tested on another laptop)
!models/best.pt
!models/best.onnx

# Ignore training runs (large intermediate artifacts)
runs/
training data/runs/
training data/merged_dataset/
